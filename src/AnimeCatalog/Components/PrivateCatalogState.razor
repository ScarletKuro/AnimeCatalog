@inject NavigationManager NavigationManager

@* Thin wrapper over AccessState: it exists to own the catalog-visibility wording and the sign-in
   link, so the card surface itself stays shared with the admin gates. *@
<AccessState Title="@Title" Message="@Message">
    <Action>
        <NavLink href="@LoginLink.ForCurrentPage(NavigationManager)" class="button button--primary">Sign in</NavLink>
    </Action>
</AccessState>

@code {
    [Parameter]
    public string Title { get; set; } = AnimeCatalog.Infrastructure.CatalogAccess.PrivateTitle;

    [Parameter]
    public string Message { get; set; } = AnimeCatalog.Infrastructure.CatalogAccess.PrivateMessage;
}
