<ul class="franchise-entry-list">
    @foreach (var entry in Entries)
    {
        <li class="franchise-entry-list__item">
            <div>
                <NavLink href="@($"anime/{entry.AnimeEntry.Id}")" class="franchise-entry-list__title">@entry.PrimaryTitle</NavLink>
                <div class="franchise-entry-list__subline">
                    <StatusBadge Status="entry.CatalogEntry.Status" />
                    <ProgressDisplay EpisodesWatched="entry.CatalogEntry.EpisodesWatched" TotalEpisodes="entry.AnimeEntry.Episodes" />
                </div>
            </div>
            <RatingDisplay Score="entry.CatalogEntry.Score" />
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<AnimeListItemViewModel> Entries { get; set; }
}
