@* Where you are and how to move, as one control. The calendars used to spell the two out separately -
   a range line under the heading, and a row of full-width text buttons beside it - which on a phone
   wrapped to two rows and fought the heading for the width. Putting the label between the arrows
   means one row does both jobs, and it is the shape every date picker already uses.

   The arrows are icon-only, so each states its own name: this is the one place the house preference
   for a self-describing label cannot apply. That is also why the label between them is not a heading
   or a live region - it is the value of the control, announced by the buttons that change it. *@
<div class="period-stepper">
    <button type="button" class="period-stepper__step" aria-label="@PreviousLabel" disabled="@PreviousDisabled" @onclick="OnPrevious">
        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
            <path d="M12.25 5.25 7.5 10l4.75 4.75" />
        </svg>
    </button>

    <p class="period-stepper__value">@Value</p>

    <button type="button" class="period-stepper__step" aria-label="@NextLabel" disabled="@NextDisabled" @onclick="OnNext">
        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
            <path d="M7.75 5.25 12.5 10l-4.75 4.75" />
        </svg>
    </button>
</div>

@code {
    /// <summary>The period on screen - a week range, a year - rendered between the arrows.</summary>
    [Parameter, EditorRequired]
    public required string Value { get; set; }

    /// <summary>Names the back arrow for anyone who cannot see it, eg "Previous week".</summary>
    [Parameter, EditorRequired]
    public required string PreviousLabel { get; set; }

    [Parameter, EditorRequired]
    public required string NextLabel { get; set; }

    [Parameter]
    public bool PreviousDisabled { get; set; }

    [Parameter]
    public bool NextDisabled { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnPrevious { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnNext { get; set; }
}
