@* The chevron toggle idiom from FranchiseCard, extracted so every collapsible section shares it.
   FranchiseCard itself is deliberately left alone; its markup is asserted by existing tests.

   aria-expanded is written as an explicit string because Blazor omits an attribute whose value is
   the bool false, and a disclosure control must always expose it, collapsed or not. *@
<button type="button"
        class="@(Expanded ? "disclosure disclosure--open" : "disclosure")"
        aria-expanded="@(Expanded ? "true" : "false")"
        aria-controls="@ControlsId"
        @onclick="OnToggle">
    <span>@CurrentLabel</span>
    <span class="disclosure__chevron" aria-hidden="true">
        <svg viewBox="0 0 20 20" focusable="false">
            <path d="M5.25 7.5 10 12.25 14.75 7.5" />
        </svg>
    </span>
</button>

@code {
    [Parameter]
    public bool Expanded { get; set; }

    [Parameter, EditorRequired]
    public required string CollapsedLabel { get; set; }

    /// <summary>Falls back to <see cref="CollapsedLabel"/> when not supplied.</summary>
    [Parameter]
    public string? ExpandedLabel { get; set; }

    /// <summary>Id of the element this button expands, for <c>aria-controls</c>.</summary>
    [Parameter]
    public string? ControlsId { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private string CurrentLabel => Expanded ? ExpandedLabel ?? CollapsedLabel : CollapsedLabel;
}
