@inject BrowserStorageService BrowserStorage

@if (Max is null)
{
    @* No known total (currently-airing or unenriched entries), so there is no range to
       enumerate. Typing stays the only honest option here rather than inventing a ceiling. *@
    @* Labelled here rather than by the host: the field's .field-label span no longer wraps the
       control, since the grid branch is a group and not a single labelable input. *@
    <div class="episode-picker">
        <input class="text-input"
               type="number"
               min="0"
               aria-label="Episodes watched"
               aria-describedby="@HintId"
               value="@_episodes"
               @onchange="HandleManualChangeAsync" />

        <p class="episode-picker__hint" id="@HintId">@HintText</p>
    </div>
}
else
{
    <div class="episode-picker">
        @* The count is a tally of finished episodes, not the episode you are on, and neither the
           numbers nor the fill can say which of the two it is. Stated once here, and shown in
           the track itself by the dashed cell after the selection. *@
        <p class="episode-picker__hint" id="@HintId">@HintText</p>

        @* Managed focus instead of one tab stop per option: a 1000-episode entry would
           otherwise bury every control after it behind a thousand tab presses. The group
           takes the tab stop and aria-activedescendant reports which option is current. *@
        <div class="episode-picker__options"
             role="radiogroup"
             aria-label="Episodes watched"
             aria-describedby="@HintId"
             tabindex="0"
             aria-activedescendant="@OptionId(_episodes)"
             @onkeydown="HandleKeyDownAsync"
             @ref="_options">
            @for (var episode = 0; episode <= Ceiling; episode++)
            {
                var value = episode;
                var isSelected = _episodes == value;
                var isWatched = value > 0 && value <= _episodes;
                var isNext = value == _episodes + 1 && value <= Ceiling;

                <button type="button"
                        id="@OptionId(value)"
                        class="@OptionClass(isSelected, isWatched, isNext)"
                        role="radio"
                        tabindex="-1"
                        aria-checked="@isSelected"
                        aria-label="@(value == 0 ? "No episodes watched" : $"Watched through episode {value}")"
                        @onclick="() => SelectAsync(value)">
                    @* "None" rather than a bare 0: beside 1, 2, 3 the digit reads as an episode
                       number, which is the opposite of what selecting it means. *@
                    @(value == 0 ? "None" : value.ToString())
                </button>
            }
        </div>

        @* Deliberately not ProgressDisplay: "4 / 12" is exactly the reading this field has to
           disambiguate. The cards and lists keep it, since there the count is only reported. *@
        <p class="episode-picker__value">@SummaryText</p>
    </div>
}

@code {
    private const string HintText = "Pick the last episode you finished.";

    private readonly string _idPrefix = $"episode-picker-{Guid.NewGuid():N}";
    private ElementReference _options;
    private int? _scrolledValue;
    private bool _skipScroll;

    // Rendered from, and written by, the handlers below -- never the parameter itself. Writing to
    // a [Parameter] is unsupported: the next parent render pushes the old value straight back
    // over it. See "Avoid overwriting parameters in ASP.NET Core Blazor".
    private int _episodes;

    [Parameter]
    public int Value { get; set; }

    /// <summary>Total episodes for the entry. Null renders a plain number field instead of a range.</summary>
    [Parameter]
    public int? Max { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    /// <summary>
    /// Whether the count is worth offering at all. A Completed entry means every episode, and
    /// selecting Completed already fills the count in, so a range would only offer ways to
    /// contradict the status. Hosts gate the whole field on this rather than the picker
    /// blanking itself, since the field label is theirs to hide. An unknown total is the
    /// exception: the auto-fill has nothing to copy, so the count stays editable.
    /// </summary>
    public static bool IsEditable(CatalogStatus status, int? max) =>
        status != CatalogStatus.Completed || max is null;

    // Stale rows can carry more watched episodes than the total (the total was corrected
    // downward later), so the range stretches to keep the current value selectable instead
    // of leaving nothing highlighted.
    private int Ceiling => Math.Max(Max ?? 0, _episodes);

    private string HintId => $"{_idPrefix}-hint";

    // Spells out what the number means, since the digit alone cannot: which episode is finished,
    // which one is next, and how much is left. Branches on Max rather than Ceiling -- Ceiling
    // stretches for the stale rows above, so a row holding 30 against a corrected-down total of
    // 25 would otherwise claim every episode is watched.
    private string SummaryText
    {
        get
        {
            if (_episodes == 0)
            {
                return Ceiling >= 1
                    ? "Nothing watched yet · start with episode 1"
                    : "Nothing watched yet";
            }

            if (Max is not { } max)
            {
                return $"Watched through episode {_episodes}";
            }

            if (_episodes > max)
            {
                return $"Watched through episode {_episodes} · more than the recorded total of {max}";
            }

            if (_episodes == max)
            {
                return max == 1 ? "Watched the only episode" : $"All {max} episodes watched";
            }

            return $"Watched through episode {_episodes} · next up {_episodes + 1} · {max - _episodes} left";
        }
    }

    // OnParametersSet rather than OnInitialized: the same instance is reused when the details
    // page swaps entries or the status auto-fill jumps the count to the total, and a parent that
    // rejects an edit has to be able to pull the track back to what it holds.
    protected override void OnParametersSet() => _episodes = Value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The number-field branch renders no scroll track, so there is nothing to centre.
        if (Max is null)
        {
            return;
        }

        // Clicking a visible option must not yank the list out from under the cursor. A value
        // that arrived through parameters (status -> Completed jumps to the total) must scroll.
        // The flag is consumed before the early return below so a click the parent rejects
        // cannot leave it set and swallow the next parameter-driven scroll.
        var skip = _skipScroll;
        _skipScroll = false;

        if (_scrolledValue == _episodes)
        {
            return;
        }

        _scrolledValue = _episodes;

        if (skip)
        {
            return;
        }

        await BrowserStorage.ScrollSelectedOptionIntoViewAsync(_options);
    }

    private string OptionId(int episode) => $"{_idPrefix}-{episode}";

    private static string OptionClass(bool isSelected, bool isWatched, bool isNext)
    {
        var classes = "episode-picker__option";

        if (isWatched)
        {
            classes += " episode-picker__option--watched";
        }

        if (isNext)
        {
            classes += " episode-picker__option--next";
        }

        if (isSelected)
        {
            classes += " episode-picker__option--selected";
        }

        return classes;
    }

    private Task SelectAsync(int episodes)
    {
        if (_episodes == episodes)
        {
            return Task.CompletedTask;
        }

        _skipScroll = true;
        return SetAsync(episodes);
    }

    // ArrowUp/ArrowDown are left to the browser: the column count comes from CSS auto-fit, so
    // the component cannot know what "one row up" means. Native scrolling is the better answer.
    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        var target = args.Key switch
        {
            "ArrowLeft" => _episodes - 1,
            "ArrowRight" => _episodes + 1,
            "Home" => 0,
            "End" => Ceiling,
            _ => _episodes
        };

        target = Math.Clamp(target, 0, Ceiling);

        return target == _episodes ? Task.CompletedTask : SetAsync(target);
    }

    private Task HandleManualChangeAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var episodes) || episodes < 0 || episodes == _episodes)
        {
            return Task.CompletedTask;
        }

        return SetAsync(episodes);
    }

    private Task SetAsync(int episodes)
    {
        _episodes = episodes;
        return ValueChanged.InvokeAsync(episodes);
    }
}
