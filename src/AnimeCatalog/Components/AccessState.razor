@* Refused-access card, shared by the catalog-visibility gate and the admin gates. Deliberately not
   an ErrorState: nothing failed, access is simply not granted, so it reads as a next step rather
   than as a fault.

   Purely presentational on purpose - it injects nothing and knows nothing about auth. Callers that
   need a sign-in link build it themselves with LoginLink.ForCurrentPage and pass it as Action. *@
<div class="access-card">
    <span class="access-card__badge" aria-hidden="true">
        @if (Badge == AccessBadge.Shield)
        {
            <svg viewBox="0 0 20 20" focusable="false">
                <path d="M10 2.75 4.75 5v4.4c0 3.3 2.15 6.2 5.25 7.1 3.1-.9 5.25-3.8 5.25-7.1V5L10 2.75Z" />
                <path d="M7.5 9.75h5" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 20 20" focusable="false">
                <rect x="4.25" y="8.5" width="11.5" height="8" rx="2.25" />
                <path d="M7 8.5V6.25a3 3 0 0 1 6 0V8.5" />
                <path d="M10 11.75v2" />
            </svg>
        }
    </span>
    <h3>@Title</h3>
    <p class="access-card__body">@Message</p>
    @if (Action is not null)
    {
        <div class="button-row">@Action</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter]
    public AccessBadge Badge { get; set; } = AccessBadge.Lock;

    /// <summary>What the visitor can do about it. Omitted when there is genuinely nothing.</summary>
    [Parameter]
    public RenderFragment? Action { get; set; }
}
