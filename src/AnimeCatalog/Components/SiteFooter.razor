<footer class="site-footer">
    <div class="site-footer__inner">
        <a class="site-footer__link"
           href="@BuildInfo.SourceRepositoryUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Open source code on GitHub"
           title="Source code">
            <span class="site-footer__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-2.98-.88-2.98-2.9 0-.58.21-1.07.55-1.45-.05-.13-.24-.66.05-1.37 0 0 .59-.19 1.94.72a5.4 5.4 0 0 1 2.9 0c1.35-.92 1.94-.72 1.94-.72.29.71.1 1.24.05 1.37.34.38.55.87.55 1.45 0 2.03-1.21 2.7-2.99 2.9.31.27.58.79.58 1.6 0 1.15-.01 2.09-.01 2.38 0 .21.15.46.55.38A7.99 7.99 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
            </span>
            <span>source</span>
        </a>
        <a class="site-footer__commit"
           href="@BuildInfo.CommitUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="@CommitLabel"
           title="@CommitLabel">@BuildInfo.ShortCommitSha</a>
    </div>
</footer>

@code {
    private static string CommitLabel =>
        BuildInfo.FullCommitSha is null
            ? "Local build"
            : $"Open deployed commit {BuildInfo.ShortCommitSha} on GitHub";
}
