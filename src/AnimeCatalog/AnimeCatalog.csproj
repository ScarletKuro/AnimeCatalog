<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <PropertyGroup Label="Tailwind.Hosting.Build Props">
    <TailwindVersion>latest</TailwindVersion>
    <TailwindWatch>true</TailwindWatch>
    <TailwindInputCssFile>wwwroot/css/styles.css</TailwindInputCssFile>
    <TailwindOutputCssFile>wwwroot/css/app.css</TailwindOutputCssFile>
    <TailwindConfigFile>tailwind.config.js</TailwindConfigFile>
    <TailwindMinifyOnPublish>true</TailwindMinifyOnPublish>
    <TailwindExcludeInputFileOnPublish>true</TailwindExcludeInputFileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
    <PackageReference Include="Tailwind.Hosting" Version="1.2.2" />
    <PackageReference Include="Tailwind.Hosting.Build" Version="1.2.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Drop the Tailwind-generated stylesheet from the default wwwroot Content glob at
    EVALUATION time. Tailwind.Hosting.Build re-adds it from its TailwindGenerateOutput
    target (CopyToPublishDirectory="Always"), so without this removal the SDK sees two
    assets for 'css/app#[.{fingerprint}]?.css' and fails with "Two assets found targeting
    the same path with incompatible asset kinds".

    This must stay an evaluation-time ItemGroup, NOT a target. A `<Target ...
    BeforeTargets="PrepareForBuild">` doing the same Remove ran after the package's re-add
    on Linux (while winning the race on Windows), stripping app.css from the publish output
    and deploying a stylesheet-less site to GitHub Pages. The package removes its own input
    file the same way.
  -->
  <ItemGroup>
    <Content Remove="$(TailwindOutputCssFile)" />
  </ItemGroup>

</Project>
