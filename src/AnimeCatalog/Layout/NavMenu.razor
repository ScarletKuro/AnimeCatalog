@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable
@implements IAsyncDisposable

<header class="site-header">
    <div class="site-header__inner">
        <NavLink href="" Match="NavLinkMatch.All" class="site-brand">
            <span class="site-brand__mark" aria-hidden="true"></span>
            <span class="site-brand__title">Anime Catalog</span>
        </NavLink>

        <nav class="site-nav">
            <NavLink href="" Match="NavLinkMatch.All" class="site-nav__link">Home</NavLink>
            <NavLink href="catalog" class="site-nav__link">Catalog</NavLink>
            @* No Match here, unlike the admin link below: prefix matching is WANTED so the
               archive routes keep this lit. /calendar has no sibling that could double-activate. *@
            <NavLink href="calendar" class="site-nav__link">Calendar</NavLink>
            @if (AuthService.IsAdmin)
            {
                <NavLink href="watch-next" class="site-nav__link">Watch next</NavLink>
                @* Prefix matching would light this up on /admin/add too, so both admin links
                   would read as active at once. *@
                <NavLink href="admin" Match="NavLinkMatch.All" class="site-nav__link">Admin</NavLink>
                <NavLink href="admin/add" class="site-nav__link site-nav__link--action">+ Add</NavLink>
            }
        </nav>

        <div class="site-actions">
            @if (!AuthService.IsConfigured)
            {
                <span class="site-chip site-chip--muted">Supabase not configured</span>
            }
            else if (AuthService.IsAuthenticated)
            {
                <div class="@ProfileMenuClass" @ref="_profileMenuElement">
                    <button
                        type="button"
                        class="profile-menu__trigger"
                        aria-expanded="@(_isProfileMenuOpen ? "true" : "false")"
                        aria-haspopup="menu"
                        @onclick="ToggleProfileMenuAsync">
                        <span class="profile-menu__avatar" aria-hidden="true">
                            @if (HasAvatar)
                            {
                                <img class="profile-menu__avatar-image" src="@AvatarUrl" alt="" />
                            }
                            else
                            {
                                @UserInitials
                            }
                        </span>
                        <span class="profile-menu__identity">
                            <span class="profile-menu__name">@DisplayName</span>
                            <span class="profile-menu__role">@(AuthService.IsAdmin ? "Admin access" : "Signed in")</span>
                        </span>
                        <span class="profile-menu__chevron" aria-hidden="true">
                            <svg viewBox="0 0 20 20" focusable="false">
                                <path d="M5.25 7.5 10 12.25 14.75 7.5" />
                            </svg>
                        </span>
                    </button>

                    @if (_isProfileMenuOpen)
                    {
                        <div class="profile-menu__panel" role="menu">
                            <div class="profile-menu__panel-head">
                                <span class="profile-menu__avatar profile-menu__avatar--large" aria-hidden="true">
                                    @if (HasAvatar)
                                    {
                                        <img class="profile-menu__avatar-image" src="@AvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        @UserInitials
                                    }
                                </span>
                                <div class="profile-menu__meta">
                                    <strong>@DisplayName</strong>
                                    <span>@(AuthService.IsAdmin ? "Admin access" : "Signed in")</span>
                                </div>
                            </div>

                            @if (AuthService.IsAdmin)
                            {
                                <NavLink href="admin" class="profile-menu__link">
                                    <span class="profile-menu__link-icon" aria-hidden="true">
                                        <svg viewBox="0 0 20 20" focusable="false">
                                            <path d="M10 2.5 16 5.5v4.5c0 3.75-2.6 6.8-6 7.5-3.4-.7-6-3.75-6-7.5V5.5l6-3Z" />
                                        </svg>
                                    </span>
                                    <span>Open admin</span>
                                </NavLink>
                            }

                            <button type="button" class="profile-menu__link profile-menu__link--danger" @onclick="LogoutAsync">
                                <span class="profile-menu__link-icon" aria-hidden="true">
                                    <svg viewBox="0 0 20 20" focusable="false">
                                        <path d="M8 3.5h-2A2.5 2.5 0 0 0 3.5 6v8A2.5 2.5 0 0 0 6 16.5h2" />
                                        <path d="M11 6.5 14.5 10 11 13.5" />
                                        <path d="M6.5 10h8" />
                                    </svg>
                                </span>
                                <span>Sign out</span>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <NavLink href="login" class="button button--primary">Owner sign in</NavLink>
            }
        </div>

        @* Below 960px .site-nav and .site-actions are hidden and this single control replaces both,
           so the header never needs a second row. aria-expanded is an explicit string because
           Blazor omits an attribute whose value is the bool false. *@
        <button
            type="button"
            class="nav-toggle"
            aria-controls="nav-drawer"
            aria-expanded="@(_isDrawerOpen ? "true" : "false")"
            aria-label="@(_isDrawerOpen ? "Close menu" : "Open menu")"
            @onclick="ToggleDrawerAsync"
            @onkeydown="HandleDrawerKeyDownAsync">
            @if (AuthService.IsConfigured && AuthService.IsAuthenticated)
            {
                <span class="nav-toggle__avatar" aria-hidden="true">
                    @if (HasAvatar)
                    {
                        <img class="profile-menu__avatar-image" src="@AvatarUrl" alt="" />
                    }
                    else
                    {
                        @UserInitials
                    }
                </span>
            }
            <span class="nav-toggle__burger" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </button>

        @* Rendered only while open so the closed header emits exactly one copy of every nav link -
           a permanently-rendered drawer would give /admin/add two .active anchors. *@
        @if (_isDrawerOpen)
        {
            <div class="nav-drawer" id="nav-drawer" @onkeydown="HandleDrawerKeyDownAsync">
                @if (AuthService.IsConfigured && AuthService.IsAuthenticated)
                {
                    <div class="nav-drawer__head">
                        <span class="profile-menu__avatar profile-menu__avatar--large" aria-hidden="true">
                            @if (HasAvatar)
                            {
                                <img class="profile-menu__avatar-image" src="@AvatarUrl" alt="" />
                            }
                            else
                            {
                                @UserInitials
                            }
                        </span>
                        <div class="profile-menu__meta">
                            <strong>@DisplayName</strong>
                            <span>@(AuthService.IsAdmin ? "Admin access" : "Signed in")</span>
                        </div>
                    </div>
                }

                <nav class="nav-drawer__nav">
                    <NavLink href="" Match="NavLinkMatch.All" class="nav-drawer__link">Home</NavLink>
                    <NavLink href="catalog" class="nav-drawer__link">Catalog</NavLink>
                    <NavLink href="calendar" class="nav-drawer__link">Calendar</NavLink>
                    @if (AuthService.IsAdmin)
                    {
                        <NavLink href="watch-next" class="nav-drawer__link">Watch next</NavLink>
                        @* Same reason as .site-nav: prefix matching would claim /admin/add too. *@
                        <NavLink href="admin" Match="NavLinkMatch.All" class="nav-drawer__link">Admin</NavLink>
                        <NavLink href="admin/add" class="nav-drawer__link nav-drawer__link--action">+ Add</NavLink>
                    }
                </nav>

                <div class="nav-drawer__footer">
                    @if (!AuthService.IsConfigured)
                    {
                        <span class="site-chip site-chip--muted">Supabase not configured</span>
                    }
                    else if (AuthService.IsAuthenticated)
                    {
                        <button type="button" class="nav-drawer__link nav-drawer__link--danger" @onclick="LogoutAsync">Sign out</button>
                    }
                    else
                    {
                        <NavLink href="login" class="button button--primary">Owner sign in</NavLink>
                    }
                </div>
            </div>
        }
    </div>
</header>

@* Outside the header on purpose: .site-header sets backdrop-filter, which makes it the containing
   block for fixed-position descendants, so a nested inset-0 backdrop would be clipped to the header. *@
@if (_isDrawerOpen)
{
    <div class="nav-drawer__backdrop" aria-hidden="true" @onclick="CloseDrawerAsync"></div>
}

@code {
    private ElementReference _profileMenuElement;
    private IJSObjectReference? _browserModule;
    private int _outsideClickRegistrationId;
    private bool _isProfileMenuOpen;
    private bool _isDrawerOpen;
    private bool _outsideClickSyncPending;
    private bool _scrollLockSyncPending;

    protected override void OnInitialized()
    {
        AuthService.StateChanged += HandleStateChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_outsideClickSyncPending)
        {
            _outsideClickSyncPending = false;
            await SyncOutsideClickHandlerAsync();
        }

        if (_scrollLockSyncPending)
        {
            _scrollLockSyncPending = false;
            await SyncScrollLockAsync();
        }
    }

    private async Task ToggleProfileMenuAsync()
    {
        _isProfileMenuOpen = !_isProfileMenuOpen;
        _outsideClickSyncPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleDrawerAsync()
    {
        await SetDrawerOpenAsync(!_isDrawerOpen);
    }

    private async Task CloseDrawerAsync()
    {
        await SetDrawerOpenAsync(false);
    }

    private async Task HandleDrawerKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" or "Esc")
        {
            await CloseDrawerAsync();
        }
    }

    private async Task SetDrawerOpenAsync(bool isOpen)
    {
        if (_isDrawerOpen == isOpen)
        {
            return;
        }

        _isDrawerOpen = isOpen;
        _scrollLockSyncPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        _isProfileMenuOpen = false;
        _outsideClickSyncPending = true;

        if (_isDrawerOpen)
        {
            _isDrawerOpen = false;
            _scrollLockSyncPending = true;
        }

        await AuthService.LogoutAsync();
    }

    private string DisplayName =>
        AuthService.CurrentSession?.User.DisplayName?.Trim() is { Length: > 0 } displayName
            ? displayName
            : "Owner";

    private string ProfileMenuClass => _isProfileMenuOpen ? "profile-menu profile-menu--open" : "profile-menu";

    private string? AvatarUrl => AuthService.CurrentSession?.User.AvatarUrl;

    private bool HasAvatar => !string.IsNullOrWhiteSpace(AvatarUrl);

    private string UserInitials
    {
        get
        {
            var parts = DisplayName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Take(2)
                .Select(static part => char.ToUpperInvariant(part[0]))
                .ToArray();

            return parts.Length > 0 ? new string(parts) : "AC";
        }
    }

    [JSInvokable]
    public async Task HandleOutsideProfileClickAsync()
    {
        if (!_isProfileMenuOpen)
        {
            return;
        }

        _isProfileMenuOpen = false;
        _outsideClickSyncPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncOutsideClickHandlerAsync()
    {
        _browserModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/auth.js");

        if (_outsideClickRegistrationId != 0)
        {
            await _browserModule.InvokeVoidAsync("unregisterOutsideClick", _outsideClickRegistrationId);
            _outsideClickRegistrationId = 0;
        }

        if (_isProfileMenuOpen)
        {
            _outsideClickRegistrationId = await _browserModule.InvokeAsync<int>(
                "registerOutsideClick",
                _profileMenuElement,
                DotNetObjectReference.Create(this),
                nameof(HandleOutsideProfileClickAsync));
        }
    }

    private async Task SyncScrollLockAsync()
    {
        _browserModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/auth.js");
        await _browserModule.InvokeVoidAsync("setBodyScrollLock", _isDrawerOpen);
    }

    // Covers every drawer link, including a tap on the route already showing, which NavLink
    // reports as a location change even though the URL does not move.
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!_isDrawerOpen)
        {
            return;
        }

        _isDrawerOpen = false;
        _scrollLockSyncPending = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleStateChanged()
    {
        _isProfileMenuOpen = false;
        _outsideClickSyncPending = true;

        if (_isDrawerOpen)
        {
            _isDrawerOpen = false;
            _scrollLockSyncPending = true;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.StateChanged -= HandleStateChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (_browserModule is not null)
        {
            if (_outsideClickRegistrationId != 0)
            {
                await _browserModule.InvokeVoidAsync("unregisterOutsideClick", _outsideClickRegistrationId);
            }

            // A lock left behind would freeze scrolling on whatever renders next.
            if (_isDrawerOpen)
            {
                await _browserModule.InvokeVoidAsync("setBodyScrollLock", false);
            }

            await _browserModule.DisposeAsync();
        }
    }
}
