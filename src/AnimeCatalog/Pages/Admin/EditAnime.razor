@page "/admin/edit/{Id:long}"
@inject CatalogService CatalogService
@inject AdminCatalogService AdminCatalogService
@inject NavigationManager NavigationManager
@inject AuthService AuthService

<PageTitle>Edit anime</PageTitle>

@* Sign-out has to take the content off screen here and now: with visibility set to private the
   rendered catalog is no longer readable by this visitor, and nothing else re-runs the access check
   until a navigation or a hard refresh. *@
<AuthStateWatcher OnIdentityChanged="LoadAsync" />

<section class="stack">
    <div class="page-header">
        <div>
            <p class="eyebrow">Admin</p>
            <h1>Edit anime entry</h1>
            <p class="lede">Adjust cached metadata, move the entry between franchises, and update score or progress.</p>
        </div>
    </div>

    @if (!AuthService.IsAdmin)
    {
        <AdminAccessState Purpose="editing entries" />
    }
    else if (_isLoading)
    {
        <LoadingIndicator Text="Loading anime entry..." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Title="Edit anime failed" Message="@_error" Retry="LoadAsync" />
    }
    else if (_model is not null)
    {
        <AnimeEditorForm
            Model="_model"
            Franchises="_franchises"
            IsSaving="_isSaving"
            SubmitLabel="Save changes"
            SavingLabel="Saving..."
            OnValidSubmit="SaveAsync">
            <FooterActions>
                <NavLink href="@($"anime/{Id}")" class="button button--ghost">Back to details</NavLink>
            </FooterActions>
        </AnimeEditorForm>
    }
</section>

@code {
    [Parameter]
    public long Id { get; set; }

    private AnimeEditorModel? _model;
    private IReadOnlyList<Franchise> _franchises = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // Same guard Dashboard uses: the markup already hides everything behind !IsAdmin, and an
        // auth-change reload must not fire a request that Supabase is going to refuse anyway.
        if (!AuthService.IsAdmin)
        {
            _isLoading = false;
            _model = null;
            return;
        }

        try
        {
            _isLoading = true;
            _error = null;
            _model = await CatalogService.GetEditorModelAsync(Id);
            _franchises = await CatalogService.GetFranchisesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        try
        {
            _isSaving = true;
            _error = null;
            var id = await AdminCatalogService.SaveAsync(_model);
            NavigationManager.NavigateTo($"anime/{id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
